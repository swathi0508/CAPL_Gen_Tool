/*
 *  Library Name: SignalValidation_Lib.cin
 *  Description: Unified Physical Validation Framework for CANoe.
 */

variables
{
  const double PHYS_TOLERANCE = 0.0001;

}

// ============================================================================
// 1. LOGGING CONTROL
// ============================================================================

void START_LOGGING_TEST_CASE(char logging_file_name[])
{
  char buffer[256];
  snprintf(buffer, elcount(buffer), "/Logs/%s.blf", logging_file_name);
  setLogFileName("can_logging", buffer);
  startLogging("can_logging");
}

void STOP_LOGGING_TEST_CASE()
{
  stopLogging("can_logging");
}

// ============================================================================
// 2. CAN SIGNAL UTILITIES
// ============================================================================

void SETCHECK_CAN_SIGNAL(char signalName[], double targetPhys, double offset, double resolution, dword timeoutMs)
{
  if(setSignal(signalName, targetPhys) != 0)
  {
    testStepFail("CAN_Err", "Critical: Signal <%s> not found or could not be set.", signalName);
    return;
  }
  CHECK_CAN_SIGNAL(signalName, targetPhys, offset, resolution, timeoutMs);
}

void CHECK_CAN_SIGNAL(char signalName[], double targetPhys, double offset, double resolution, dword timeoutMs)
{
  int64 targetRaw;
  targetRaw = (int64)(((targetPhys - offset) / resolution) + (targetPhys >= offset ? 0.5 : -0.5));

  if(timeoutMs > 0)
  {
    if(testWaitForRawSignalMatch(signalName, targetRaw, timeoutMs) == 1) 
      testStepPass("CAN_Match", "Signal <%s> reached Target (Raw %lld)", signalName, targetRaw);
    else 
      testStepFail("CAN_Timeout", "Signal <%s>: Expected Raw %lld, Got %lld", signalName, targetRaw, getRawSignal(signalName));
  }
  else
  {
    if(getRawSignal(signalName) == targetRaw) 
      testStepPass("CAN_Match", "Signal <%s> == Raw %lld", signalName, targetRaw);
    else 
      testStepFail("CAN_Mismatch", "Signal <%s>: Expected Raw %lld, Got %lld", signalName, targetRaw, getRawSignal(signalName));
  }
}

// ============================================================================
// 3. SOME/IP EVENT UTILITIES
// ============================================================================

void SETCHECK_SOMEIP_EVENT_SIGNAL(char eventSignalName[], double targetPhys, dword timeoutMs)
{
  if(setServiceSignal(eventSignalName, targetPhys) != 0)
  {
    testStepFail("SOMEIP_Err", "Critical: SOME/IP Signal <%s> not found or could not be set.", eventSignalName);
    return;
  }
  WAIT_FOR_SOMEIP_EVENT(eventSignalName, targetPhys, timeoutMs);
}

void WAIT_FOR_SOMEIP_EVENT(char eventSignalName[], double targetPhys, dword timeoutMs)
{
  double currentPhys;
  int64 startTime;
  startTime = timeNowInt64();

  while (1)
  {
    currentPhys = getServiceSignal(eventSignalName);
    if (abs(currentPhys - targetPhys) <= PHYS_TOLERANCE)
    {
      testStepPass("SOMEIP_Wait", "Match: <%s> Physical %.4f", eventSignalName, currentPhys);
      return;
    }
    if (timeoutMs == 0 || ((timeNowInt64() - startTime) / 100000) >= timeoutMs) break;
    testWaitForTimeoutSilent(10);
  }
  testStepFail("SOMEIP_Timeout", "Signal <%s>: Expected Phys %.4f, Got %.4f", eventSignalName, targetPhys, currentPhys);
}

