void SOMEIP_FF_SENDONCE(char ns[], char name[])
{
  if(sysSetVariableLong(ns, name, 1) != 0)
  {
    testStepFail("FF_Err", "Critical: Could not trigger PDU %s::%s", ns, name);
    return;
  }
  testWaitForTimeoutSilent(100); 
  sysSetVariableLong(ns, name, 0);
  testStepPass("FF_Success", "PDU Trigger %s::%s executed", ns, name);
}

