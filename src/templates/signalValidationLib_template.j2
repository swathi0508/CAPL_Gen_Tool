// --- FLOAT ---
void SETCHECK_SYSVAR_FLOAT(char ns[], char name[], float targetValue, dword timeoutMs)
{
  if(sysSetVariableFloat(ns, name, targetValue) != 0)
  {
    testStepFail("SysVar_Err", "Critical: SysVar %s::%s not found or could not be set.", ns, name);
    return;
  }
  WAIT_FOR_SYSVAR_FLOAT(ns, name, targetValue, timeoutMs);
}

void WAIT_FOR_SYSVAR_FLOAT(char ns[], char name[], float targetValue, dword timeoutMs)
{
  double cur;
  int64 startTime = timeNowInt64();
  while(1) {
    cur = sysGetVariableFloat(ns, name);
    if(abs(cur - targetValue) <= PHYS_TOLERANCE) { 
      testStepPass("SysVar_Wait", "%s::%s Match: %f", ns, name, cur); return; 
    }
    if(timeoutMs == 0 || ((timeNowInt64() - startTime) / 100000) >= timeoutMs) break;
    testWaitForTimeoutSilent(10);
  }
  testStepFail("SysVar_Timeout", "%s::%s: Expected %f, Got %f", ns, name, targetValue, cur);
}

