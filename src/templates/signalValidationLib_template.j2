// ============================================================================
// 6. FIRE & FORGET CONTROL
// ============================================================================

void SOMEIP_FF_SENDONCE(char ns[], char name[])
{
  if(sysSetVariableLong(ns, name, 1) != 0)
  {
    testStepFail("FF_Err", "Critical: Could not trigger PDU %s::%s", ns, name);
    return;
  }
  testWaitForTimeoutSilent(100); 
  sysSetVariableLong(ns, name, 0);
  testStepPass("FF_Success", "PDU Trigger %s::%s executed", ns, name);
}


// ============================================================================
// 7. Define Pre-condition to set the gadeStatus to GADESTATUS_MISSION_MODE_ON
// ============================================================================

void PRECONDITION__SET_GADESTATUS_TO_GADESTATUS_MISSION_MODE_ON()
{
  {%- set s_state = signals.gadeStatusValueState -%}
  {%- set s_status = signals.gadeStatus %}
  testStep("#1 Pre condition", "Set {{ s_state.path | default('MISSING_DATA') }} = {{ s_state.enum_name | default('MISSING_DATA') }}");
  SETCHECK_SOMEIP_EVENT_SIGNAL("{{ s_state.path | default('MISSING_DATA') }}", {{ s_state.enum_value | default('MISSING_DATA') }}, SOMEIP_TIMEOUT);
 
  testStep("#2 Pre condition", "Set {{ s_status.path | default('MISSING_DATA') }} = {{ s_status.enum_name | default('MISSING_DATA') }}");
  SETCHECK_SOMEIP_EVENT_SIGNAL("{{ s_status.path | default('MISSING_DATA') }}", {{ s_status.enum_value | default('MISSING_DATA') }}, SOMEIP_TIMEOUT);
}
