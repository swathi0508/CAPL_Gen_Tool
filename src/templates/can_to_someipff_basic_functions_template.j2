/* ============================================================================
   AUTO-GENERATED CAPL TEST SCRIPTS : CAN -> SOME/IP FF
   ============================================================================ */

{% set processed_funcs = [] %}
{% for row in requirements %}
{% if row.Basic_Function not in processed_funcs %}
{% set _ = processed_funcs.append(row.Basic_Function) %}
void {{ row.Basic_Function | default('MISSING_DATA') }}()
{
{% for label in row.labels %}
  {% set act_step = loop.index0 * 2 + 1 %}
  {% set chk_step = act_step + 1 %}
  testStep("#{{ act_step }} Action", "Set {{ row.CAN_DB_SIGNAL_NAME | default('MISSING_DATA') }} = I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}");
  {% if row.IS_ENUM | string | upper == 'TRUE' %}
  SETCHECK_CAN_SIGNAL("{{ row.CAN_DB_SIGNAL_NAME | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}, CAN_TIMEOUT);
  {% else %}
  SETCHECK_CAN_SIGNAL("{{ row.CAN_DB_SIGNAL_NAME | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}, I{{ row.CAN_PORT | default('MISSING_DATA') }}_Offset, I{{ row.CAN_PORT | default('MISSING_DATA') }}_Resolution, CAN_TIMEOUT);
  {% endif %}

  testStep("#{{ chk_step }} Verify", "Check SOME/IP FF SysVar '{{ row.SOMEIP_FF_DB_SIGNAL_NAME | default('MISSING_DATA') }}' for expected {{ label }} value");
  {% if row.IS_ENUM | string | upper == 'TRUE' %}
  WAIT_FOR_SYSVAR_LONG("{{ row.SOMEIP_FF_DB_SIGNAL_NAME | default('MISSING_DATA') }}", O{{ row.SOMEIP_PORT }}_{{ row.ATTRIBUTE_VALUE }}_{{ label }}, 4000);
  {% else %}
  {% if label == 'Min' %}{% set val = row.COMPUTED_SOMEIP_FF_VALUE_MIN %}{% elif label == 'Mid' %}{% set val = row.COMPUTED_SOMEIP_FF_VALUE_MID %}{% else %}{% set val = row.COMPUTED_SOMEIP_FF_VALUE_MAX %}{% endif %}
    {% if row.DATATYPE | lower in ['float', 'double', 'real'] %}
  WAIT_FOR_SYSVAR_FLOAT("{{ row.SOMEIP_FF_DB_SIGNAL_NAME | default('MISSING_DATA') }}", {{ val }}, 4000);
    {% else %}
  WAIT_FOR_SYSVAR_LONG("{{ row.SOMEIP_FF_DB_SIGNAL_NAME | default('MISSING_DATA') }}", {{ val }}, 4000);
    {% endif %}
  {% endif %}
  
  {% if not loop.last %}

  {% endif %}
{% endfor %}

  testStep("#7 Check", "Check sysvarMember::{{ row.SOMEIP_FF_DB_SIGNAL_VALUESTATE | default('MISSING_DATA') }} = VALUE_STATE_VALID");
  WAIT_FOR_SYSVAR_LONG("{{ row.SOMEIP_FF_DB_SIGNAL_VALUESTATE | default('MISSING_DATA') }}", VALUE_STATE_VALID, 9000);
}

{% endif %}
{% endfor %}