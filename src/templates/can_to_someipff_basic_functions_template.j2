/* ============================================================================
   AUTO-GENERATED CAPL TEST SCRIPTS : CAN -> SOME/IP FF
   ============================================================================ */
{% set processed_funcs = [] -%}
{% for row in requirements -%}
{% if row.Basic_Function not in processed_funcs -%}
{% set _ = processed_funcs.append(row.Basic_Function) -%}
void {{ row.Basic_Function | default('MISSING_DATA') }}()
{
{%- for label in row.labels %}
  {%- set act_step = loop.index0 * 2 + 1 %}{% set chk_step = act_step + 1 %}
  testStep("#{{ act_step }} SET_CAN", "Set {{ row.CAN_DB_SIGNAL_NAME | default('MISSING_DATA') }} = I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}");
{%- if row.IS_ENUM | string | upper == 'TRUE' %}
  SETCHECK_CAN_SIGNAL("{{ row.CAN_DB_SIGNAL_NAME | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}, 0, 1, CAN_TIMEOUT);
{%- else %}
  SETCHECK_CAN_SIGNAL("{{ row.CAN_DB_SIGNAL_NAME | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}, I{{ row.CAN_PORT | default('MISSING_DATA') }}_Offset, I{{ row.CAN_PORT | default('MISSING_DATA') }}_Resolution, CAN_TIMEOUT);
{%- endif %}

  testStep("#{{ chk_step }} CHECK_SOMEIP_FF", "Check SOME/IP FF SysVar '{{ row.SOMEIP_FF_DB_SIGNAL_NAME | default('MISSING_DATA') }}' = 
{%- if row.IS_ENUM | string | upper == 'TRUE' -%}
{{ row.SOMEIP_PORT }}_{{ row.ATTRIBUTE_VALUE }}_{{ label }}
{%- else -%}
I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}
{%- endif %}");
{%- if row.IS_ENUM | string | upper == 'TRUE' %}
  WAIT_FOR_SYSVAR_LONG("{{ row.SOMEIP_FF_SIGNAME_NAMESPACE | default('MISSING_DATA') }}", "{{ row.SOMEIP_FF_SIGNAME_VARIABLE | default('MISSING_DATA') }}", {{ row.SOMEIP_PORT }}_{{ row.ATTRIBUTE_VALUE }}_{{ label }}, SOMEIP_TIMEOUT);
{%- else %}
{%- if row.DATATYPE | lower in ['float', 'double', 'real'] %}
  WAIT_FOR_SYSVAR_FLOAT("{{ row.SOMEIP_FF_SIGNAME_NAMESPACE | default('MISSING_DATA') }}", "{{ row.SOMEIP_FF_SIGNAME_VARIABLE | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}, SOMEIP_TIMEOUT);
{%- else %}
  WAIT_FOR_SYSVAR_LONG("{{ row.SOMEIP_FF_SIGNAME_NAMESPACE | default('MISSING_DATA') }}", "{{ row.SOMEIP_FF_SIGNAME_VARIABLE | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_{{ label }}, SOMEIP_TIMEOUT);
{%- endif %}
{%- endif %}
{{ "" }}
{%- endfor %}
  testStep("#7 CHECK_SOMEIP_FF_VALUESTATE", "Check sysvarMember::{{ row.SOMEIP_FF_DB_SIGNAL_VALUESTATE | default('MISSING_DATA') }} = VALUE_STATE_VALID");
  WAIT_FOR_SYSVAR_LONG("{{ row.SOMEIP_FF_SIGVALUESTATE_NAMESPACE | default('MISSING_DATA') }}", "{{ row.SOMEIP_FF_SIGVALUESTATE_VARIABLE | default('MISSING_DATA') }}", VALUE_STATE_VALID, SOMEIP_TIMEOUT);
}

{% endif -%}
{% endfor -%}
