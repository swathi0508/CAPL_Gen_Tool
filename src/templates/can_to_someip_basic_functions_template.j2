  SETCHECK_CAN_SIGNAL("{{ row.CAN_DB_SIGNAL_NAME | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_Max, {{ row.CAN_OFFSET | default('MISSING_DATA') }}, {{ row.CAN_RESOLUTION | default('MISSING_DATA') }}, CAN_TIMEOUT);
  
