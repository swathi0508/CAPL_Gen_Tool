  WAIT_FOR_SOMEIP_EVENT("{{ row.SOMEIP_DB_SIGNAL_NAME | default('MISSING_DATA') }}", I{{ row.CAN_PORT | default('MISSING_DATA') }}_Max, SOMEIP_TIMEOUT);
{% endif %}
